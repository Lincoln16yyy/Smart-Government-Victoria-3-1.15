							flowcontainer = {
								direction = horizontal
								spacing = 6
								parentanchor = vcenter
								ignoreinvisible = yes

								textbox = {
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									text = "sg_law_name_230"
									tooltip = "sg_law_tip_230"
									using = tooltip_se
								}
								textbox = {
									autoresize = yes
									align = left|nobaseline
									using = fontsize_small
									default_format = "#weak"
									text = "sg_law_group_230"
								}
							}
						}
			}

			button = {
				position = { -8 0 }
				parentanchor = right|vcenter
				size = { 84 24 }
				using = select_button_sound
				using = tooltip_se
				text = "sg_restore"
				tooltip = "sg_restore_tt"
				enabled = "[GetScriptedGui('sg_restore_ignored_3_sgui').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				onclick = "[GetScriptedGui('sg_restore_ignored_3_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
			}
		}
	}


	flowcontainer = {
		visible = "[GetScriptedGui('sg_research_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		direction = vertical
		spacing = 5
