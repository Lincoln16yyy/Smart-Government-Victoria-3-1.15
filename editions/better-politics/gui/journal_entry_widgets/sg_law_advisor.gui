	# ---- footer ---------------------------------------------------------------
	flowcontainer = {
		direction = horizontal
		spacing = 8
		ignoreinvisible = yes

		button = {
			visible = "[Or(Or(GetScriptedGui('sg_ignored_1_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End), GetScriptedGui('sg_ignored_2_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)), GetScriptedGui('sg_ignored_3_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End))]"
			size = { 150 28 }
			using = select_button_sound
			using = tooltip_se
			text = "sg_clear_ignored"
			tooltip = "sg_clear_ignored_tt"
			onclick = "[GetScriptedGui('sg_clear_ignored_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		button = {
			size = { 150 28 }
			using = select_button_sound
			using = tooltip_se
			text = "sg_diagnostics"
			tooltip = "sg_diagnostics_tt"
			onclick = "[GetScriptedGui('sg_diagnostics_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		textbox = {
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			default_format = "#weak"
			text = "sg_footer_note"
		}
	}

	flowcontainer = {
		visible = "[GetScriptedGui('sg_military_ready_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		direction = vertical
		spacing = 6
		ignoreinvisible = yes

		widget = {
			size = { 500 36 }
			background = { using = dark_area }
			textbox = {
				position = { 8 0 }
				parentanchor = vcenter
				autoresize = yes
				using = fontsize_medium
				text = "sg_military_title"
			}
			button_icon_round_action = {
				position = { -6 0 }
				parentanchor = right|vcenter
				size = { 32 32 }
				blockoverride "icon" {
					texture = "gfx/interface/buttons/button_icons/reset.dds"
				}
				using = select_button_sound
				using = tooltip_se
				tooltip = "sg_military_refresh_tt"
				enabled = "[GetScriptedGui('sg_military_refresh_sgui').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				onclick = "[GetScriptedGui('sg_military_refresh_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
