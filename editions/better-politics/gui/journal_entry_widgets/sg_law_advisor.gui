	# ---- recommendation 2 -------------------------------------------------
	widget = {
		visible = "[GetScriptedGui('sg_top_2_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		minimumsize = { 500 190 }
		maximumsize = { 500 250 }
		background = { using = dark_area }

		flowcontainer = {
			margin = { 10 8 }
			direction = vertical
			spacing = 6
			ignoreinvisible = yes
			minimumsize = { 480 -1 }
			maximumsize = { 480 -1 }

			flowcontainer = {
				direction = horizontal
				spacing = 8
				ignoreinvisible = yes

				textbox = {
					size = { 28 28 }
					align = left|nobaseline
					using = fontsize_medium
					default_format = "#high"
					raw_text = "2."
				}

				widget = {
					visible = "[GetScriptedGui('sg_top_2_law_law_mass_conscription_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
					flowcontainer = {
						direction = vertical
						spacing = 1
						ignoreinvisible = yes
