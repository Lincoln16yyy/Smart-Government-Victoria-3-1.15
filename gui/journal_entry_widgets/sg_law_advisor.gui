	# ---- empty state ----------------------------------------------------------
	textbox = {
		visible = "[Not(GetScriptedGui('sg_top_1_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End))]"
		autoresize = yes
		multiline = yes
		align = left|nobaseline
		using = fontsize_medium
		default_format = "#weak"
		minimumsize = { 500 -1 }
		maximumsize = { 500 -1 }
		text = "sg_empty"
	}

	# ---- footer ---------------------------------------------------------------
	flowcontainer = {
		direction = horizontal
		spacing = 8
		ignoreinvisible = yes

		button = {
			visible = "[Or(Or(GetScriptedGui('sg_ignored_1_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End), GetScriptedGui('sg_ignored_2_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)), GetScriptedGui('sg_ignored_3_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End))]"
			size = { 150 28 }
			using = select_button_sound
			using = tooltip_se
			text = "sg_clear_ignored"
			tooltip = "sg_clear_ignored_tt"
			onclick = "[GetScriptedGui('sg_clear_ignored_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		button = {
			size = { 150 28 }
			using = select_button_sound
			using = tooltip_se
			text = "sg_diagnostics"
			tooltip = "sg_diagnostics_tt"
			onclick = "[GetScriptedGui('sg_diagnostics_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		textbox = {
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			default_format = "#weak"
			text = "sg_footer_note"
		}
	}
