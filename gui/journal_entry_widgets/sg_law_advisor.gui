					text = "[SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_focus').GetValue, '(int32)2'), 'sg_focus_1', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_focus').GetValue, '(int32)3'), 'sg_focus_2', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_focus').GetValue, '(int32)4'), 'sg_focus_3', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_focus').GetValue, '(int32)5'), 'sg_focus_4', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_focus').GetValue, '(int32)6'), 'sg_focus_5', 'sg_focus_6')))))]"
				}
				textbox = {
					autoresize = yes
					align = left|nobaseline
					using = fontsize_small
					text = "SG_SCORE_LABEL"
				}
				textbox = {
					autoresize = yes
					align = left|nobaseline
					using = fontsize_small
					default_format = "#high"
					raw_text = "[JournalEntry.GetCountry.MakeScope.Var('sg_top_3_score').GetValue|0]"
				}
				textbox = {
					autoresize = yes
					align = left|nobaseline
					using = fontsize_small
					text = "SG_SUPPORT_LABEL"
				}
				textbox = {
					autoresize = yes
					align = left|nobaseline
					using = fontsize_small
					raw_text = "[JournalEntry.GetCountry.MakeScope.Var('sg_top_3_politics').GetValue|0]"
				}
				textbox = {
					autoresize = yes
					align = left|nobaseline
					using = fontsize_small
					text = "SG_RISK_LABEL"
				}
				textbox = {
					autoresize = yes
					align = left|nobaseline
					using = fontsize_small
					raw_text = "[JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk_score').GetValue|0]"
				}
			}

			textbox = {
				autoresize = yes
				multiline = yes
				align = left|nobaseline
				using = fontsize_small
				minimumsize = { 480 -1 }
				maximumsize = { 480 -1 }
				text = "[SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)2'), 'sg_benefit_1', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)3'), 'sg_benefit_2', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)4'), 'sg_benefit_3', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)5'), 'sg_benefit_4', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)6'), 'sg_benefit_5', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)7'), 'sg_benefit_6', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)8'), 'sg_benefit_7', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)9'), 'sg_benefit_8', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)10'), 'sg_benefit_9', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)11'), 'sg_benefit_10', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)12'), 'sg_benefit_11', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)13'), 'sg_benefit_12', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)14'), 'sg_benefit_13', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)15'), 'sg_benefit_14', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_benefit').GetValue, '(int32)16'), 'sg_benefit_15', 'sg_benefit_16')))))))))))))))]"
			}
			textbox = {
				autoresize = yes
				multiline = yes
				align = left|nobaseline
				using = fontsize_small
				default_format = "#warning"
				minimumsize = { 480 -1 }
				maximumsize = { 480 -1 }
				text = "[SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)2'), 'sg_risk_1', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)3'), 'sg_risk_2', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)4'), 'sg_risk_3', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)5'), 'sg_risk_4', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)6'), 'sg_risk_5', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)7'), 'sg_risk_6', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)8'), 'sg_risk_7', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)9'), 'sg_risk_8', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)10'), 'sg_risk_9', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)11'), 'sg_risk_10', SelectLocalization(LessThan_int32(JournalEntry.GetCountry.MakeScope.Var('sg_top_3_risk').GetValue, '(int32)12'), 'sg_risk_11', 'sg_risk_12')))))))))))]"
			}
			flowcontainer = {
				direction = horizontal
				spacing = 8
				ignoreinvisible = yes

				button = {
					size = { 100 28 }
					using = select_button_sound
					using = tooltip_se
					text = "SG_ENACT"
					tooltip = "SG_ENACT_TT"
					enabled = "[GetScriptedGui('sg_enact_3_sgui').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
					onclick = "[GetScriptedGui('sg_enact_3_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				}
				button = {
					size = { 100 28 }
					using = select_button_sound
					using = tooltip_se
					text = "SG_IGNORE"
					tooltip = "SG_IGNORE_TT"
					enabled = "[GetScriptedGui('sg_ignore_3_sgui').IsValid(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
					onclick = "[GetScriptedGui('sg_ignore_3_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
				}
				textbox = {
					visible = "[Not(StringIsEmpty([JournalEntry.GetCountry.MakeScope.Var('sg_top_3_law').GetLawType.GetBlockingRequirements(GetPlayer.Self)]))]"
					autoresize = yes
					align = left|nobaseline
					using = fontsize_small
					default_format = "#warning"
					text = "SG_REQUIREMENTS_HINT"
					tooltip = "[JournalEntry.GetCountry.MakeScope.Var('sg_top_3_law').GetLawType.GetBlockingRequirements(GetPlayer.Self)]"
					using = tooltip_se
				}
				textbox = {
					visible = "[Not(StringIsEmpty([JournalEntry.GetCountry.MakeScope.Var('sg_top_3_law').GetLawType.GetEffectDesc(GetPlayer.Self)]))]"
					autoresize = yes
					align = left|nobaseline
					using = fontsize_small
					default_format = "#weak"
					text = "SG_EFFECTS_HINT"
					tooltip = "[JournalEntry.GetCountry.MakeScope.Var('sg_top_3_law').GetLawType.GetEffectDesc(GetPlayer.Self)]"
					using = tooltip_se
				}
			}
		}
	}

	# ---- empty state ----------------------------------------------------------
	textbox = {
		visible = "[Not(GetScriptedGui('sg_top_1_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End))]"
		autoresize = yes
		multiline = yes
		align = left|nobaseline
		using = fontsize_medium
		default_format = "#weak"
		minimumsize = { 500 -1 }
		maximumsize = { 500 -1 }
		text = "SG_EMPTY"
	}

	# ---- footer ---------------------------------------------------------------
	flowcontainer = {
		direction = horizontal
		spacing = 8
		ignoreinvisible = yes

		button = {
			visible = "[Or(GetScriptedGui('sg_ignored_1_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End), GetScriptedGui('sg_ignored_2_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End), GetScriptedGui('sg_ignored_3_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End))]"
			size = { 150 28 }
			using = select_button_sound
			using = tooltip_se
			text = "SG_CLEAR_IGNORED"
			tooltip = "SG_CLEAR_IGNORED_TT"
			onclick = "[GetScriptedGui('sg_clear_ignored_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		button = {
			size = { 150 28 }
			using = select_button_sound
			using = tooltip_se
			text = "SG_DIAGNOSTICS"
			tooltip = "SG_DIAGNOSTICS_TT"
			onclick = "[GetScriptedGui('sg_diagnostics_sgui').Execute(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		}
		textbox = {
			autoresize = yes
			align = left|nobaseline
			using = fontsize_small
			default_format = "#weak"
			text = "SG_FOOTER_NOTE"
		}
	}
}
