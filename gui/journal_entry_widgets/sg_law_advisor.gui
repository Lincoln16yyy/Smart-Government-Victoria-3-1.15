	widget = {
		visible = "[GetScriptedGui('sg_top_3_visible_sgui').IsShown(GuiScope.SetRoot(JournalEntry.GetCountry.MakeScope).End)]"
		minimumsize = { 500 -1 }
		maximumsize = { 500 -1 }
		background = { using = dark_area }

		flowcontainer = {
			position = { 10 7 }
			direction = vertical
			spacing = 2
			ignoreinvisible = yes
			minimumsize = { 480 -1 }
			maximumsize = { 480 -1 }

			flowcontainer = {
				direction = horizontal
				spacing = 6
				ignoreinvisible = yes

